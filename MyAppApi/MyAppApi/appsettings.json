{
  "__comment": [
    "Non-sensitive defaults only. This file is committed, so nothing here may be a",
    "real credential. Every secret is supplied at run time and overrides the empty",
    "value below:",
    "  Development -> .NET User Secrets:  dotnet user-secrets set \"Key\" \"value\"",
    "  Production  -> environment variables, '__' as the section separator, e.g.",
    "                 ConnectionStrings__InvestContextDBMonster",
    "The application refuses to start when a required secret is missing rather than",
    "falling back to a placeholder (see Program.cs). An empty string here therefore",
    "means 'must be provided', not 'optional'."
  ],
  "ConnectionStrings": {
    "InvestContextDB": "",
    "InvestContextDBMonster": ""
  },
  "JwtSettings": {
    "Issuer": "MyAppApi",
    "Audience": "MyAppApiClient",
    "Key": "",
    "ExpirationMinutes": 60
  },
  "AuthSecurity": {
    "RefreshTokenDays": 14,
    "EmailVerificationTokenMinutes": 60,
    "EmailVerificationResendCooldownSeconds": 60,
    "RequireVerifiedEmailForLogin": true,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 10,
    "PasswordResetResendCooldownSeconds": 60,
    "PasswordResetMaxFailedAttempts": 5
  },
  "FileUploadSecurity": {
    "MaxImageBytes": 2097152,
    "AllowedImageContentTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/bmp"
    ]
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Vestora",
    "EnableSsl": true,
    "LogCodesInDevelopment": false
  },
  "AdminBootstrap": {
    "SecretKey": ""
  },
  "Payments": {
    "Provider": "simulated",
    "Currency": "USD",
    "FeeRateBps": 500,
    "CheckoutTtlMinutes": 35,
    "FundingRequestTtlDays": 14,
    "ReturnBaseUrl": "http://localhost:3000",
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "ApiBase": "https://api.stripe.com"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
