{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vestora-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "Frontend/vestora"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vestora-backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "MyAppApi/MyAppApi/MyAppApi.csproj", "--launch-profile", "http"],
      "port": 5078
    }
  ]
}
