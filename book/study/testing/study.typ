= Terms You Must Know

المصطلحات اللي ممكن تتسأل فيها مباشرة.

#figure(
  table(
    columns: (auto, 1fr),
    align: (right + top, right + top),
    table.header([المصطلح], [المعنى]),
    [Unit test],
      [اختبار دالة واحدة لوحدها، من غير قاعدة بيانات ولا سيرفر.],
    [Integration test],
      [اختبار بيشغّل النظام الحقيقي (سيرفر + قاعدة بيانات) ويتأكد إن
       الطبقات شغّالة مع بعض.],
    [`WebApplicationFactory`],
      [أداة بتشغّل الـAPI كامل في الذاكرة، من غير بورت حقيقي.],
    [EF Core InMemory provider],
      [قاعدة بيانات وهمية بتنفّذ LINQ على الكائنات مباشرة، مش بترجمه
       لـSQL — عكس SQLite أو SQL Server.],
    [Mock / Simulated provider],
      [تنفيذ وهمي لخدمة خارجية (زي `SimulatedPaymentProvider`) بيتصرّف
       زي الحقيقي من غير ما يكلّم الإنترنت.],
    [`[Authorize(Roles = "...")]`],
      [فحص الدور — بيتأكد إنك مؤسّس أو مستثمر، مش إن الحاجة دي بتاعتك.],
    [Ownership check],
      [فحص إضافي (`OwnerId != currentUserId`) بيتأكد إن الحاجة فعلًا
       بتاعتك، مش بس إن دورك يسمح.],
    [User enumeration],
      [تسريب معلومة إن إيميل معيّن مسجّل في المنصّة ولا لأ.],
    [Token rotation],
      [كل استعمال لـrefresh token بيولّد واحد جديد ويلغي القديم.],
    [Reuse detection],
      [استخدام توكن مُلغى = إشارة سرقة ⇒ إلغاء كل الجلسات.],
    [Idempotent],
      [نداء العملية مرتين بيدّي نفس النتيجة بالظبط.],
    [Manual testing],
      [إنسان بيفتح المنتج بإيده ويجرّب، من غير أداة آلية.],
    [Regression],
      [كسر حاجة كانت شغّالة قبل كده بسبب تعديل جديد.],
  ),
  caption: [ثلاثة عشر مصطلح.],
