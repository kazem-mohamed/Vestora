   [`AppDbContext` نفسه Repository و Unit of Work — طبقة فوقه كانت هتبقى غلاف على غلاف.]),
  ([إمتى التحقق بيحصل في رحلة الطلب؟],
   [في خطوة الـ Model Binding، عن طريق الـ attributes قبل ما الكود بتاعي يشتغل أصلًا.]),
))

