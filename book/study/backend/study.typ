#keypoint[
  *أقوى لحظة في العرض كله* هي الخطوة 5. تدوير التوكن وكشف إعادة الاستخدام
  حاجة قليل ما تتشاف في مشاريع تخرّج — ولما توريها *شغّالة* قدّامهم،
  الفرق بين «قرأت عنها» و«نفّذتها» بيبان فورًا.

  اتمرّن عليها لحد ما تعملها من غير ما تفكّر.
]

= Terms You Must Know

المصطلحات اللي ممكن تتسأل فيها مباشرة.

#figure(
  table(
    columns: (auto, 1fr),
    align: (right + top, right + top),
    table.header([المصطلح], [المعنى]),
    [ORM],
      [طبقة بتحوّل الكلاسات لجداول والعكس — هنا EF Core.],
    [`DbContext`],
      [بوابة التعامل مع الداتابيز، وهو نفسه Repository و Unit of Work.],
    [LINQ],
      [لغة الاستعلام اللي بتتكتب في `C#` وبتتحوّل لـ SQL.],
    [DTO],
      [كائن نقل بيانات — شكل الطلب أو الرد، منفصل عن كيان الداتابيز.],
    [Model binding],
      [تحويل الـ JSON الجاي لكائن `C#`، والتحقق بيحصل وقتها.],
    [`ModelState`],
      [نتيجة التحقق — بتحمل الأخطاء على مستوى كل حقل.],
    [DI],
      [حقن التبعيات — بتطلب الحاجة كـ interface والـ container بيجيبها.],
    [Middleware],
      [حلقات بتشتغل على كل طلب قبل ما يوصل للكنترولر.],
    [JWT],
      [توكن موقّع بيحمل هوية المستخدم ودوره جوّاه.],
    [Claim],
      [معلومة جوّه التوكن — زي `NameIdentifier` و `Role`.],
    [Access token],
      [توكن قصير المدة بيتبعت مع كل طلب.],
    [Refresh token],
      [توكن طويل المدة بيتبدّل بواحد جديد — وبيتخزّن مهشّر.],
    [Token rotation],
      [كل استعمال بيولّد توكن جديد ويلغي القديم.],
    [Reuse detection],
      [استعمال توكن مُلغى = إشارة سرقة ⇒ إلغاء كل الجلسات.],
    [BCrypt],
      [خوارزمية هاش لكلمات السر، *بطيئة عن قصد*.],
    [User enumeration],
      [تسريب معلومة إن إيميل معيّن مسجّل عندنا ولا لأ.],
    [Idempotent],
      [نداء العملية مرتين بيدّي نفس النتيجة بالظبط.],
    [Soft delete],
      [إخفاء الصف بعمود بدل مسحه فعليًا.],
    [Global query filter],
      [شرط بيتطبّق تلقائيًا على كل استعلام لكيان معيّن.],
    [Facet],
      [قيمة فلتر ومعاها عدد النتائج المتوقّع.],
    [ETag],
      [بصمة للمحتوى بتخلّي المتصفّح ياخد 304 بدل البايتس تاني.],
  ),
  caption: [واحد وعشرون مصطلح.],
)

